{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Around Town Movers scheduler: Leads and Storage-market data (DynamoDB) plus the IAM user the Firebase backend uses. Generated by server/scripts/make-aws-template.js - do not edit by hand.",
  "Parameters": {
    "Prefix": {
      "Type": "String",
      "Default": "atm-",
      "AllowedPattern": "^[a-z0-9-]*$",
      "Description": "Prefix for every table and the IAM user. Use atm-stg- for a staging copy. Must match ATM_DDB_PREFIX in the app."
    },
    "AlertEmail": {
      "Type": "String",
      "Default": "",
      "Description": "Optional. Email address to warn when this AWS ACCOUNT's monthly cost passes 80% of MonthlyBudgetUsd. Leave empty to skip the budget."
    },
    "MonthlyBudgetUsd": {
      "Type": "Number",
      "Default": 5,
      "Description": "Monthly cost (USD) for the whole AWS account that the budget alert watches."
    }
  },
  "Conditions": {
    "HasAlertEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlertEmail"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "LeadTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}leads"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "leadId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "leadId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "Lead"
          }
        ]
      }
    },
    "MatchedLeadTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}matched-leads"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "matchId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "matchId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "MatchedLead"
          }
        ]
      }
    },
    "LegacyCustomerTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}legacy-customers"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "customerId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "customerId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "LegacyCustomer"
          }
        ]
      }
    },
    "StorageFacilityTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}storage-facilities"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "facilityId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "facilityId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "StorageFacility"
          }
        ]
      }
    },
    "StoragePricingTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}storage-pricing"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "priceId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "day",
            "AttributeType": "S"
          },
          {
            "AttributeName": "scrapedAt",
            "AttributeType": "S"
          },
          {
            "AttributeName": "fu",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "priceId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "StoragePricing"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "byDay",
            "KeySchema": [
              {
                "AttributeName": "day",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "scrapedAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "byFacilityUnit",
            "KeySchema": [
              {
                "AttributeName": "fu",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "scrapedAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ]
      }
    },
    "MlsBenchmarkTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}mls-benchmarks"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "benchmarkId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "benchmarkId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "MlsBenchmark"
          }
        ]
      }
    },
    "ScrapeRunTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}scrape-runs"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "runId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "runId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "ScrapeRun"
          }
        ]
      }
    },
    "EmailNoticeTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}email-notices"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "noticeId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "noticeId",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "EmailNotice"
          }
        ]
      }
    },
    "AppStateTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Prefix}app-state"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "stateKey",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "stateKey",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "app",
            "Value": "atm-scheduler"
          },
          {
            "Key": "entity",
            "Value": "AppState"
          }
        ]
      }
    },
    "DataWriterUser": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "UserName": {
          "Fn::Sub": "${Prefix}data-writer"
        },
        "Policies": [
          {
            "PolicyName": "atm-dynamodb-tables-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:BatchGetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:BatchWriteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan",
                    "dynamodb:DescribeTable"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "LeadTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "MatchedLeadTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "LegacyCustomerTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "StorageFacilityTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "StoragePricingTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${StoragePricingTable.Arn}/index/*"
                    },
                    {
                      "Fn::GetAtt": [
                        "MlsBenchmarkTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "ScrapeRunTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "EmailNoticeTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "AppStateTable",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "CostBudget": {
      "Type": "AWS::Budgets::Budget",
      "Condition": "HasAlertEmail",
      "Properties": {
        "Budget": {
          "BudgetName": {
            "Fn::Sub": "${Prefix}monthly-cost"
          },
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "BudgetLimit": {
            "Amount": {
              "Ref": "MonthlyBudgetUsd"
            },
            "Unit": "USD"
          }
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 80,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "AlertEmail"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "LeadTableName": {
      "Value": {
        "Ref": "LeadTable"
      }
    },
    "MatchedLeadTableName": {
      "Value": {
        "Ref": "MatchedLeadTable"
      }
    },
    "LegacyCustomerTableName": {
      "Value": {
        "Ref": "LegacyCustomerTable"
      }
    },
    "StorageFacilityTableName": {
      "Value": {
        "Ref": "StorageFacilityTable"
      }
    },
    "StoragePricingTableName": {
      "Value": {
        "Ref": "StoragePricingTable"
      }
    },
    "MlsBenchmarkTableName": {
      "Value": {
        "Ref": "MlsBenchmarkTable"
      }
    },
    "ScrapeRunTableName": {
      "Value": {
        "Ref": "ScrapeRunTable"
      }
    },
    "EmailNoticeTableName": {
      "Value": {
        "Ref": "EmailNoticeTable"
      }
    },
    "AppStateTableName": {
      "Value": {
        "Ref": "AppStateTable"
      }
    },
    "DataWriterUserName": {
      "Value": {
        "Ref": "DataWriterUser"
      },
      "Description": "Create its access key with: aws iam create-access-key --user-name <this value>"
    }
  }
}
