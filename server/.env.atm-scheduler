# Plain (non-secret) config for the atm-scheduler Cloud Functions deployment — Firebase Functions
# v2's naming convention: a `.env.<project-id>` file here is automatically uploaded as environment
# config on `firebase deploy`, project-specific. This is NOT the same mechanism as
# `firebase functions:secrets:set` (see server/functions-index.js's defineSecret calls for the
# actual secrets: SESSION_SECRET, SMTP_PASS, SMARTMOVING_API_KEY, WEBHOOK_SECRET) — nothing
# sensitive belongs in this file. Safe to commit, unlike server/.env.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=atm.sspr@gmail.com

ADMIN_EMAIL=csr4@aroundtownmovers.com

# 30 (was 7): the diff-only poll only re-checks jobs whose SmartMoving service date falls in this window, so a job corrected to a date older than 7 days (e.g. 24567-3, 2026-11-03) was never re-read. See sync-architecture §7.
POLL_LOOKBACK_DAYS=30
POLL_LOOKAHEAD_DAYS=30

# Served over HTTPS via Firebase Hosting — adds the Secure flag to the session cookie.
COOKIE_SECURE=true

# Explicitly off in production — see server/.env.example for what this does.
DEV_BYPASS_LOGIN=false
