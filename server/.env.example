# Copy this file to .env and fill in your real key. Never commit .env or put the key in the
# frontend HTML — it stays server-side only.

SMARTMOVING_API_KEY=paste-your-key-here

# Shared secret SmartMoving must send back on every webhook POST (as ?secret=... or an
# x-webhook-secret header) — pick any random string and put the same one in SmartMoving's webhook
# config. Leave blank to disable verification (fine for local testing, not for a public deploy).
# WEBHOOK_SECRET=

# How often the fallback/backfill poll sweep runs, in minutes. Set to 0 to disable it and run
# webhook-only (not recommended — a missed webhook means a permanently missed job).
# POLL_INTERVAL_MINUTES=15
# POLL_LOOKBACK_DAYS=7
# POLL_LOOKAHEAD_DAYS=60

# Usually don't need to change these:
# SMARTMOVING_BASE_URL=https://api-public.smartmoving.com/v1
# PORT=8787

# ---- Smart Insights report sync (Gmail — see server/smartInsightsGmail.js) ----
# Read-only Gmail access for the SmartMoving "Smart Insights" report pipeline — separate from
# SMARTMOVING_API_KEY above (that's SmartMoving's REST API; this reads the inbox that receives
# SmartMoving's emailed report exports). Requires a Google Cloud "Desktop app" OAuth client (Gmail
# API enabled) and a one-time local consent flow: `npm run gmail-auth` (runs
# server/gmail-oauth-setup.js), which opens a browser, asks you to sign into the Gmail account that
# receives the SmartMoving reports, and prints a refresh token. Needs a local browser + a local
# port (53682) — can't be run from a deployed server, only your own machine, once.
#
# DO NOT set GMAIL_OAUTH_CLIENT_ID / GMAIL_OAUTH_CLIENT_SECRET / GMAIL_OAUTH_REFRESH_TOKEN here in
# .env — same reason SESSION_SECRET/SMTP_PASS/SMARTMOVING_API_KEY aren't set here either (see those
# below): these three are also declared as real Firebase secrets in functions-index.js, and Cloud
# Run rejects a deploy where the same env var name is both a plain value and a secret. Put them in
# server/local.secrets instead (gitignored, loaded by load-env.js the same as this file) — see that
# file's own header comment.

# ---- Calendar sync (Google Calendar API — see server/googleCalendarClient.js) ----
# Which Google Calendar to read SmartMoving's synced dispatch events from — uses the SAME OAuth
# grant as the Smart Insights Gmail access above (its refresh token must include the
# calendar.readonly scope; see smartInsightsGmail.js's 2026-08-26 comment). This is NOT sensitive
# the way an API key is, so unlike GMAIL_OAUTH_REFRESH_TOKEN it's fine as a plain value here (or as a
# plain — not secret — Cloud Functions env var on the deployed side). Confirmed 2026-08-26: this
# account's SmartMoving calendar is a dedicated calendar (not the account's primary one), already
# hardcoded as googleCalendarClient.js's default — only set this if that calendar is ever
# recreated/re-shared under a different id.
# SMARTMOVING_CALENDAR_ID=b96aedbcd57ed48f546157b41ce23058bb058f4432837ce3db0a4a03e1d129fc@group.calendar.google.com

# ---- Firestore (see server/firestore.js for the full credential-resolution rules) ----
# The Firebase/GCP project the Firestore data lives in (atm-scheduler). Always required on AWS —
# App Runner has no GCP environment to infer this from.
FIREBASE_PROJECT_ID=atm-scheduler
# On AWS App Runner: the full contents of a downloaded service account key (Firebase console →
# atm-scheduler project → Project settings → Service accounts → Generate new private key), as one
# JSON string. Set this via an App Runner secret (Secrets Manager), not a plain env var — see
# server/README.md "AWS deployment". Leave unset for local dev (use GOOGLE_APPLICATION_CREDENTIALS
# or the emulator instead, below).
# FIREBASE_SERVICE_ACCOUNT_JSON=
# For local dev against the Firestore emulator instead of real data:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# For local dev against REAL Firestore (e.g. debugging live data without deploying) — path to that
# same downloaded service account key file (more convenient than pasting JSON into an env var on a
# laptop). Never commit that file.
# GOOGLE_APPLICATION_CREDENTIALS=

# ---- Login (email + password — see server/README.md "Login & accounts") ----
# Only @aroundtownmovers.com addresses (any case) are ever granted access. New accounts start with
# no password — the person sets their own via "Forgot password?" on the sign-in screen, which emails
# a 6-digit one-time code. That's sent by signing into a real mailbox over SMTP — a personal/free
# Gmail account by default — no domain verification or DNS records needed, unlike a transactional
# email service. See server/README.md "One-time setup: email delivery".
# The Gmail address to send from/authenticate as.
SMTP_USER=
# A Gmail "app password" (16 characters, generated at myaccount.google.com/apppasswords — requires
# 2-Step Verification to be turned on for that Google account first). NOT the regular account
# password — Google rejects that for SMTP once 2-Step Verification is on.
SMTP_PASS=
# Defaults below are already right for Gmail — only set these to use a different mailbox instead.
# Microsoft 365 (smtp.office365.com:587) is common, but many tenants have SMTP AUTH disabled
# org-wide and need an admin to re-enable it per mailbox before it'll work — see server/README.md.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Optional — defaults to SMTP_USER. Only set this if the mailbox has "send as" delegation configured
# for a different address, e.g. "ATM Scheduler <noreply@aroundtownmovers.com>".
# SMTP_FROM=

# Only used to grant the very first admin access, the one time the users table is empty. Safe to
# delete afterward (or leave it — it's ignored once any account exists). To grant more people
# access later, log in as that admin and use the Users panel, or run:
#   node create-admin.js <email> [admin|dispatcher|crew] [password]
ADMIN_EMAIL=
# Optional — if set, the first admin can sign in with this password immediately instead of needing
# SMTP_USER/SMTP_PASS configured first. Change it via "Forgot password?" afterward. If left unset,
# the account is created with no password and needs the OTP-email flow to set one.
ADMIN_PASSWORD=

# Signs login session cookies. Set this to a long random string and keep it stable — if it's left
# unset, the server generates a random one on every restart, which logs everyone out each time you
# restart it. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Set to "true" once this is served over HTTPS (adds the Secure flag to the session cookie). Leave
# unset for local http:// development.
# COOKIE_SECURE=

# ---- Local dev login bypass (NOT for production) ----
# Lets you sign in at GET /api/auth/dev-login?role=admin|dispatcher|crew without a real password or
# a configured email provider — useful for local development. Leave unset normally; never set this
# on a server reachable outside your own machine.
# DEV_BYPASS_LOGIN=

# ---- AWS DynamoDB (leads + storage data) ----
# Create the tables with aws/atm-data.template.json (see docs/AWS-DATA.md), then create an access key
# for the IAM user "atm-data-writer". In production these are Firebase secrets:
#   firebase functions:secrets:set ATM_AWS_ACCESS_KEY_ID
#   firebase functions:secrets:set ATM_AWS_SECRET_ACCESS_KEY
# ATM_AWS_ACCESS_KEY_ID=
# ATM_AWS_SECRET_ACCESS_KEY=
# ATM_AWS_REGION=us-east-1
# Table-name prefix (tables are atm-leads, atm-storage-pricing, ...).
# ATM_DDB_PREFIX=atm-
# Tests only: point at a local DynamoDB emulator (dynalite).
# ATM_DYNAMODB_ENDPOINT=
