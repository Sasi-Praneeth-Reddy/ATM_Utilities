# Copy this file to .env and fill in your real key. Never commit .env or put the key in the
# frontend HTML — it stays server-side only.

SMARTMOVING_API_KEY=paste-your-key-here

# Shared secret SmartMoving must send back on every webhook POST (as ?secret=... or an
# x-webhook-secret header) — pick any random string and put the same one in SmartMoving's webhook
# config. Leave blank to disable verification (fine for local testing, not for a public deploy).
# WEBHOOK_SECRET=

# How often the fallback/backfill poll sweep runs, in minutes. Set to 0 to disable it and run
# webhook-only (not recommended — a missed webhook means a permanently missed job).
# POLL_INTERVAL_MINUTES=15
# POLL_LOOKBACK_DAYS=7
# POLL_LOOKAHEAD_DAYS=60

# Usually don't need to change these:
# SMARTMOVING_BASE_URL=https://api-public.smartmoving.com/v1
# PORT=8787

# Where the SQLite database file lives. Defaults to server/data/atm.db (auto-created, gitignored).
# Only override this if you need the DB somewhere else — e.g. a mounted volume path on your host.
# Note: SQLite needs real local-disk file locking, so this must point at a normal filesystem path,
# not a network drive or certain container/FUSE-style mounts.
# SQLITE_PATH=

# ---- Login (email + password — see server/README.md "Login & accounts") ----
# Only @aroundtownmovers.com addresses (any case) are ever granted access. New accounts start with
# no password — the person sets their own via "Forgot password?" on the sign-in screen, which emails
# a 6-digit one-time code. That's sent by signing into a real mailbox over SMTP — a personal/free
# Gmail account by default — no domain verification or DNS records needed, unlike a transactional
# email service. See server/README.md "One-time setup: email delivery".
# The Gmail address to send from/authenticate as.
SMTP_USER=
# A Gmail "app password" (16 characters, generated at myaccount.google.com/apppasswords — requires
# 2-Step Verification to be turned on for that Google account first). NOT the regular account
# password — Google rejects that for SMTP once 2-Step Verification is on.
SMTP_PASS=
# Defaults below are already right for Gmail — only set these to use a different mailbox instead.
# Microsoft 365 (smtp.office365.com:587) is common, but many tenants have SMTP AUTH disabled
# org-wide and need an admin to re-enable it per mailbox before it'll work — see server/README.md.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Optional — defaults to SMTP_USER. Only set this if the mailbox has "send as" delegation configured
# for a different address, e.g. "ATM Scheduler <noreply@aroundtownmovers.com>".
# SMTP_FROM=

# Only used to grant the very first admin access, the one time the users table is empty. Safe to
# delete afterward (or leave it — it's ignored once any account exists). To grant more people
# access later, log in as that admin and use the Users panel, or run:
#   node create-admin.js <email> [admin|dispatcher|crew] [password]
ADMIN_EMAIL=
# Optional — if set, the first admin can sign in with this password immediately instead of needing
# SMTP_USER/SMTP_PASS configured first. Change it via "Forgot password?" afterward. If left unset,
# the account is created with no password and needs the OTP-email flow to set one.
ADMIN_PASSWORD=

# Signs login session cookies. Set this to a long random string and keep it stable — if it's left
# unset, the server generates a random one on every restart, which logs everyone out each time you
# restart it. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Set to "true" once this is served over HTTPS (adds the Secure flag to the session cookie). Leave
# unset for local http:// development.
# COOKIE_SECURE=

# ---- Local dev login bypass (NOT for production) ----
# Lets you sign in at GET /api/auth/dev-login?role=admin|dispatcher|crew without a real password or
# a configured email provider — useful for local development. Leave unset normally; never set this
# on a server reachable outside your own machine.
# DEV_BYPASS_LOGIN=
